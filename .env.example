# Example environment configuration for FastAPIProject
# Copy this file to .env and fill in your local values before running the app.
# Do not commit the real .env file to GitHub.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sys

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Upload / file storage
UPLOAD_DIR=uploadfiles

# Optional security settings
SECRET_KEY=change_me
JWT_SECRET=change_me
